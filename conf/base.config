/*
 * conf/base.config — default process resource settings
 *
 * Per-process resource directives are applied via withName selectors.
 * Phase B: callVariants + callVariantsLongDV merged into deepvariant.
 */

process {
    // ── Defaults applied to every process unless overridden by withName ──
    cpus          = 4
    memory        = '8 GB'
    errorStrategy = 'retry'
    maxRetries    = 1

    // ── Per-process overrides ──
    withName: 'align' {
        memory   = '32 GB'
        maxForks = 1
    }

    withName: 'deepvariant' {
        cpus   = 4
        memory = '32 GB'
    }

    withName: 'callVariantsLong' {
        cpus   = 4
        memory = '8 GB'
    }

    withName: 'annotateVcf' {
        cpus   = 4
        memory = '16 GB'
    }

    withName: 'benchmark' {
        cpus   = 4
        memory = '16 GB'
    }
}
