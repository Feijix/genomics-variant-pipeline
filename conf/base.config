/*
 * conf/base.config — default process resource settings
 *
 * Per-process resource directives are applied via withName selectors.
 * Names follow nf-core convention (UPPER_SNAKE_CASE, tool-based).
 */

process {
    // ── Defaults applied to every process unless overridden by withName ──
    cpus          = 4
    memory        = '8 GB'
    errorStrategy = 'retry'
    maxRetries    = 1

    // ── Alignment ──
    withName: 'BWA_MEM' {
        cpus     = 4
        memory   = '32 GB'
        maxForks = 1
    }

    withName: 'MINIMAP2_ALIGN' {
        cpus   = 4
        memory = '16 GB'   // minimap2 indexing GRCh38 needs 10-12 GB minimum
    }

    // ── Variant calling ──
    withName: 'DEEPVARIANT' {
        cpus   = 4
        memory = '32 GB'
    }

    withName: 'CLAIR3' {
        cpus   = 4
        memory = '8 GB'
    }

    withName: 'SNIFFLES2' {
        cpus   = 4
        memory = '8 GB'
    }

    withName: 'CUTESV' {
        cpus   = 4
        memory = '8 GB'
    }
    
    withName: 'MANTA' {
        cpus   = 4
        memory = '8 GB'
    }
    
    withName: 'DELLY' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'CONVERT_DELLY' {
        cpus   = 1
        memory = '2 GB'
    }
    
    withName: 'SMOOVE'         { cpus = 4; memory = '16 GB' }
    
    withName: 'GRIDSS'         { cpus = 4; memory = '24 GB' }
    
    withName: 'CONVERT_GRIDSS' { cpus = 1; memory = '4 GB'  }
    
    withName: 'SURVIVOR'       { cpus = 1; memory = '4 GB'  }
    
    // ── Postprocessing ──
    withName: 'ENSEMBLVEP_VEP' {
        cpus   = 4
        memory = '16 GB'
    }

    withName: 'HAPPY_HAPPY' {
        cpus   = 4
        memory = '16 GB'
    }

    withName: 'BEACON_VCF2BFF' {
        cpus    = 4
        memory  = '8 GB'
    }
    
    withName: 'BEACON_SV2BFF' { cpus = 1; memory = '2 GB' }
}
