/*
 * conf/base.config — default process resource settings
 *
 * Per-process resource directives are applied via withName selectors.
 * These mirror the resource directives previously hardcoded in main.nf process bodies.
 * Override on a per-run basis via --max_cpus / --max_memory or a custom profile.
 */

process {
    // ── Defaults applied to every process unless overridden by withName ──
    cpus          = 4
    memory        = '8 GB'
    errorStrategy = 'retry'
    maxRetries    = 1

    // ── Per-process overrides ──
    withName: 'align' {
        memory   = '32 GB'
        maxForks = 1
    }

    withName: 'alignLongRead' {
        memory   = '32 GB'
        maxForks = 1
    }

    withName: 'callVariants' {
        cpus   = 4
        memory = '32 GB'
    }

    withName: 'callVariantsLong' {
        cpus   = 4
        memory = '8 GB'
    }

    withName: 'callVariantsLongDV' {
        cpus   = 4
        memory = '32 GB'
    }

    withName: 'annotateVcf' {
        cpus   = 4
        memory = '16 GB'
    }

    withName: 'benchmark' {
        cpus   = 4
        memory = '16 GB'
    }
}
