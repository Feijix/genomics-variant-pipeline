/*
 * conf/base.config — default process resource settings
 *
 * Per-process resource directives are applied via withName selectors.
 * Names follow nf-core convention (UPPER_SNAKE_CASE, tool-based).
 */

process {
    // ── Defaults applied to every process unless overridden by withName ──
    cpus          = 4
    memory        = '8 GB'
    errorStrategy = 'retry'
    maxRetries    = 1

    // ── Alignment ──
    withName: 'BWA_MEM' {
        cpus     = 4
        memory   = '32 GB'
        maxForks = 1
    }

    withName: 'MINIMAP2_ALIGN' {
        cpus   = 4
        memory = '16 GB'   // minimap2 indexing GRCh38 needs 10-12 GB minimum
    }

    // ── Variant calling ──
    withName: 'DEEPVARIANT' {
        cpus   = 4
        memory = '32 GB'
    }

    withName: 'CLAIR3' {
        cpus   = 4
        memory = '8 GB'
    }

    // ── Postprocessing ──
    withName: 'ENSEMBLVEP_VEP' {
        cpus   = 4
        memory = '16 GB'
    }

    withName: 'HAPPY_HAPPY' {
        cpus   = 4
        memory = '16 GB'
    }
}
