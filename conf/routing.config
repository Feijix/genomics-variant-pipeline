/*
 * conf/routing.config — data-attribute-driven caller routing
 *
 * Nested under `params.routing` so Nextflow recognises the scope.
 * Accessed in workflow as `params.routing.profiles[...]`.
 *
 * Caller specs carry an optional `variant_class` (default 'small'). SV callers
 * declare variant_class: 'sv' so the workflow can route their output past the
 * small-variant postprocess chain.
 */

params.routing = [

    profiles: [

        // ── Illumina (short-read) ─────────────────────────────────────────
        'illumina/wgs': [
            defaults    : [
                [tool: 'deepvariant', params: [model_type: 'WGS']]
            ],
            alternatives: [
                [tool: 'manta', variant_class: 'sv', params: [:]],
                [tool: 'delly', variant_class: 'sv', params: [:]],
                [tool: 'smoove', variant_class: 'sv', params: [:]],
                [tool: 'gridss', variant_class: 'sv', params: [:]]
            ],
            somatic_defaults    : [
                [tool: 'mutect2', variant_class: 'small', params: [:]]
            ],
            somatic_alternatives: [
                [tool: 'strelka2',      variant_class: 'small', requires_normal: true, params: [:]],
                [tool: 'manta_somatic', variant_class: 'sv',    requires_normal: true, params: [:]]
            ]
        ],
        

        // ── ONT platform-level fallback ───────────────────────────────────
        'ont': [
            defaults    : [],
            alternatives: []
        ],

        // ── ONT R9.4.1 ────────────────────────────────────────────────────
        'ont/r9.4.1': [
            defaults    : [
                [tool: 'clair3', params: [platform: 'ont', model: 'r941_prom_hac_g360+g422']]
            ],
            alternatives: [
                [tool: 'sniffles2', variant_class: 'sv', params: [:]],
                [tool: 'cutesv', variant_class: 'sv', params: [
                    cutesv_params: '--max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3'
                ]]
            ],
            somatic_defaults: [],
            somatic_alternatives: []
        ],
        'ont/r9.4.1/guppy_hac_g360': [
            falls_back_to: 'ont/r9.4.1'
        ],

        // ── ONT R10.4.1 ───────────────────────────────────────────────────
        'ont/r10.4.1': [
            defaults    : [
		[tool: 'deepvariant', params: [model_type: 'ONT_R104']],
            ],
            alternatives: [
                [tool: 'clair3', params: [platform: 'ont', model: 'r1041_e82_400bps_sup_v500']],
                [tool: 'sniffles2', variant_class: 'sv', params: [:]],
                [tool: 'cutesv', variant_class: 'sv', params: [
                    cutesv_params: '--max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3'
                ]]
            ],
            // ClairS is the only long-read somatic caller wired here and requires
            // a matched normal. Tumour-only long-read calling would need ClairS-TO,
            // which is a separate tool (see §7.2).
            somatic_defaults: [
                [tool: 'clairs', variant_class: 'small', requires_normal: true,
                 params: [clairs_platform: 'ont_r10_dorado_sup_5khz_ssrs']]
            ],
            somatic_alternatives: []
        ],
        'ont/r10.4.1/dorado_sup': [
            falls_back_to: 'ont/r10.4.1'
        ],

        // ── PacBio HiFi ───────────────────────────────────────────────────
        'pacbio/hifi': [
            defaults    : [
                [tool: 'deepvariant', params: [model_type: 'PACBIO']]
            ],
            alternatives: [
                [tool: 'clair3', params: [platform: 'hifi', model: 'hifi']],
                [tool: 'sniffles2', variant_class: 'sv', params: [:]],
                [tool: 'cutesv', variant_class: 'sv', params: [
                    cutesv_params: '--max_cluster_bias_INS 1000 --diff_ratio_merging_INS 0.9 --max_cluster_bias_DEL 1000 --diff_ratio_merging_DEL 0.5'
                ]]
            ],
            somatic_defaults: [],
            somatic_alternatives: []
        ],
	// ── Read-length family fallbacks (used when platform is undeclared) ──
        'shortread': [
            defaults    : [
                [tool: 'deepvariant', params: [model_type: 'WGS']]
            ],
            alternatives: [
                [tool: 'manta', variant_class: 'sv', params: [:]],
                [tool: 'delly', variant_class: 'sv', params: [:]],
                [tool: 'smoove', variant_class: 'sv', params: [:]]
            ],
            somatic_defaults    : [
                [tool: 'mutect2', variant_class: 'small', params: [:]]
            ],
            somatic_alternatives: [
                [tool: 'strelka2',      variant_class: 'small', requires_normal: true, params: [:]],
                [tool: 'manta_somatic', variant_class: 'sv',    requires_normal: true, params: [:]]
            ]
        ],
        'longread': [
            defaults    : [
		[tool: 'deepvariant', params: [model_type: 'ONT_R104']],
            ],
            alternatives: [
                [tool: 'clair3', params: [platform: 'ont', model: 'r1041_e82_400bps_sup_v500']],
                [tool: 'sniffles2', variant_class: 'sv', params: [:]],
                [tool: 'cutesv', variant_class: 'sv', params: [
                    cutesv_params: '--max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3'
                ]]
            ],
            somatic_defaults: [],
            somatic_alternatives: []
        ]
    ],

    ensembles: [
        intersect: true,
        union    : true
    ],
    
    tools: [
	deepvariant  : [variant_class: 'small', requires_model: true],
        clair3       : [variant_class: 'small', requires_model: true],
        clairs       : [variant_class: 'small', requires_model: true],
        mutect2      : [variant_class: 'small'],
        strelka2     : [variant_class: 'small', requires: ['manta_somatic']],
        manta        : [variant_class: 'sv'],
        delly        : [variant_class: 'sv'],
        smoove       : [variant_class: 'sv'],
        gridss       : [variant_class: 'sv'],
        sniffles2    : [variant_class: 'sv'],
        cutesv       : [variant_class: 'sv'],
        manta_somatic: [variant_class: 'sv'],
    ]

]
