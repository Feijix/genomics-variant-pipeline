/*
 * conf/docker.config — Docker executor profile
 *
 * Activated with `-profile docker`. Enables Docker containerisation,
 * runs containers as the invoking user to avoid root-owned output files,
 * and applies SELinux relabeling flags for compatibility with SELinux-enabled hosts.
 */

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
    mountFlags = 'z'
}
