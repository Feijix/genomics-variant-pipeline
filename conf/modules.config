/*
 * conf/modules.config — per-process publishDir directives
 *
 * Centralised under nf-core convention. Process bodies carry no publishDir;
 * dynamic paths use closures over meta which is the first input element.
 */

process {

    // ── Alignment & BAM processing ──
    withName: 'BWA_MEM' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy', enabled: params.publish_bams ]
    }
    withName: 'MINIMAP2_ALIGN' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy', enabled: params.publish_bams ]
    }
    withName: 'SAMTOOLS_SORT' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy', enabled: params.publish_bams ]
    }
    withName: 'SAMTOOLS_INDEX' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy', enabled: params.publish_bams ]
    }
    withName: 'GATK_MARKDUPLICATES' {
	publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy', enabled: params.publish_bams ]
    }

    // ── Variant calling ──
    withName: 'DEEPVARIANT' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_deepvariant" },
            mode: 'copy'
        ]
    }
    withName: 'CLAIR3' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_clair3" },
            mode: 'copy'
        ]
    }

    withName: 'SNIFFLES2' {
        publishDir = [
            path: { "${params.outdir}/sv/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'CUTESV' {
        publishDir = [
            path: { "${params.outdir}/sv/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'MANTA' {
        publishDir = [
            path: { "${params.outdir}/sv/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'CONVERT_DELLY' {
        publishDir = [
            path: { "${params.outdir}/sv/${meta.id}" },
            mode: 'copy'
        ]
    }
    
    withName: 'GRIDSS' {
    containerOptions = '--memory=24g --memory-swap=24g'
    publishDir = [ path: { "${params.outdir}/sv/${meta.id}" }, mode: 'copy' ]
}
    
    withName: 'SMOOVE'         { publishDir = [ path: { "${params.outdir}/sv/${meta.id}" }, mode: 'copy' ] }
    
    withName: 'CONVERT_GRIDSS' { publishDir = [ path: { "${params.outdir}/sv/${meta.id}" }, mode: 'copy' ] }
    
    withName: 'SURVIVOR'       { publishDir = [ path: { "${params.outdir}/sv/${meta.id}/ensemble" }, mode: 'copy' ] }

    withName: 'TRUVARI_BENCH' {
        publishDir = [ 
            path: { "${params.outdir}/benchmark/sv" }, 
            mode: 'copy'
        ]
    }

    withName: 'BCFTOOLS_ISEC' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_ensemble" },
            mode: 'copy'
        ]
    }
    withName: 'BCFTOOLS_CONCAT' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_ensemble_union" },
            mode: 'copy'
        ]
    }

    // ── VCF postprocessing — meta.caller is the discriminator ──
    withName: 'BCFTOOLS_VIEW' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.caller}" },
            mode: 'copy'
        ]
    }
    
    withName: 'BCFTOOLS_VIEW_SV' {
        publishDir = [ 
            path: { "${params.outdir}/sv/${meta.id}/pass" }, 
            mode: 'copy'
        ]
    }

    withName: 'BCFTOOLS_NORM' {
        publishDir = [
            path: { "${params.outdir}/normalised/${meta.caller}" },
            mode: 'copy'
        ]
    }
    withName: 'ENSEMBLVEP_VEP' {
        publishDir = [
            path: { "${params.outdir}/annotated/${meta.caller}" },
            mode: 'copy'
        ]
    }
    withName: 'HAPPY_HAPPY' {
        publishDir = [
            path: { "${params.outdir}/benchmark/${meta.caller}" },
            mode: 'copy'
        ]
    }

    withName: 'BEACON_VCF2BFF' {
        publishDir = [
            path: { "${params.outdir}/beacon/${meta.caller}" },
            mode: 'copy'
        ]
    }

    withName: 'BEACON_SV2BFF' {
    publishDir = [ path: { "${params.outdir}/beacon/${meta.id}" }, mode: 'copy' ]
}
}
