/*
 * conf/modules.config — per-process publishDir and ext.args
 *
 * With the meta-map pattern, dynamic publishDir paths can be expressed as
 * closures that reference meta.id and meta.caller from the task's first input.
 *
 * Process bodies no longer carry publishDir directives — they're all here.
 */

process {

    // ── Alignment & BAM processing ──
    withName: 'align' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy' ]
    }
    withName: 'alignLongRead' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy' ]
    }
    withName: 'sortBam' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy' ]
    }
    withName: 'indexAlignedBam' {
        publishDir = [ path: { "${params.outdir}/bam" }, mode: 'copy' ]
    }

    // ── Variant calling ──
    withName: 'deepvariant' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_deepvariant" },
            mode: 'copy'
        ]
    }
    withName: 'callVariantsLong' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_clair3" },
            mode: 'copy'
        ]
    }
    withName: 'ensembleMergeLong' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_ensemble" },
            mode: 'copy'
        ]
    }
    withName: 'ensembleUnionLong' {
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}_ensemble_union" },
            mode: 'copy'
        ]
    }

    // ── VCF postprocessing — uses meta.caller as the discriminator ──
    withName: 'vcfQc' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.caller}" },
            mode: 'copy'
        ]
    }
    withName: 'normaliseVcf' {
        publishDir = [
            path: { "${params.outdir}/normalised/${meta.caller}" },
            mode: 'copy'
        ]
    }
    withName: 'annotateVcf' {
        publishDir = [
            path: { "${params.outdir}/annotated/${meta.caller}" },
            mode: 'copy'
        ]
    }
    withName: 'benchmark' {
        publishDir = [
            path: { "${params.outdir}/benchmark/${meta.caller}" },
            mode: 'copy'
        ]
    }
}
