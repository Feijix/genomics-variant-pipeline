# Truvari image mirroring the official ACEnglish/truvari Dockerfile build
# environment, which is required for `truvari refine` to work.
#
# Why this matches the official build rather than python:*-slim:
#   The slim Python images build pysam against a minimal libc/htslib where
#   pysam's `samtools.faidx()` stdout capture returns an empty string. That
#   breaks phab's extract_reference (it writes faidx output to a temp FASTA),
#   producing a 0-byte file and the "[faidx] Could not build fai index ...
#   File truncated at line 1" crash in refine. Ubuntu 22.04 (the official base)
#   builds pysam correctly, so faidx capture works and refine runs.
#
# mafft is installed from the exact .deb the official image uses (v7.505), the
# version Truvari validates against for phab MSA harmonization.
#
# Build once on the server:
#   docker build -t truvari:5.4.0 -f Dockerfile.truvari .

FROM ubuntu:22.04

RUN apt-get -qq update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -yq \
        curl \
        python3-dev \
        python3-pip \
        wget \
    && rm -rf /var/lib/apt/lists/*

# Official mafft .deb (v7.505) — same as the upstream Truvari Dockerfile.
RUN wget -q https://mafft.cbrc.jp/alignment/software/mafft_7.505-1_amd64.deb \
    && dpkg -i mafft_7.505-1_amd64.deb \
    && rm mafft_7.505-1_amd64.deb

# Pin Truvari. Upstream installs from source with the [bwa] extra; via pip the
# equivalent is the pinned release. (bwa extra only needed for `anno remap`,
# not for bench/refine, so omitted.)
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir truvari==5.4.0

RUN truvari version && mafft --version

ENTRYPOINT []