/*
 * genomics-variant-pipeline — top-level Nextflow configuration
 *
 * This file is the single source of truth for pipeline configuration.
 * Process-level resource directives live in conf/base.config.
 * Per-process publishDir and extra args live in conf/modules.config.
 * Container/executor profiles live in conf/<profile>.config.
 */

// ── Pipeline metadata ─────────────────────────────────────────────────────────
manifest {
    name            = 'genomics-variant-pipeline'
    author          = 'Afonso'
    homePage        = 'https://github.com/feijix/genomics-variant-pipeline'
    description     = 'Reproducible, technology-aware variant calling pipeline with Beacon v2 output'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '0.6.0-dev'
}

// ── Pipeline parameter defaults ───────────────────────────────────────────────
// Override at runtime with --paramName value or in a -params-file.
params {
    samplesheet         = 'data/samplesheet.routing.csv'
    reference           = 'data/reference/d1vd1/GRCh38.d1.vd1.fa'
    skip_bwa_index      = false     // set true (or --skip_bwa_index) for BAM-input runs
    outdir              = 'data/outputs'
    vep_cache           = "${System.getenv('HOME')}/vep_data"
    callers             = null      // null = use defaults; 'all' = defaults + alternatives; comma-separated list otherwise
    genome              = 'hg38'                                  // bff-tools genome key
    beacon_assembly     = 'GRCh38'
    beacon_dataset_id   = 'default'                               // Beacon datasetId override
    beacon_refdata      = "${projectDir}/data/beacon_refdata"     // reference-data bundle path
    target_region       = 'chr20'   // null => whole genome; also replaces DeepVariant's hardcoded --regions
    call_regions        = 'data/reference/chr20.bed.gz'
    germline_resource   = 'data/resources/af-only-gnomad.chr20.vcf.gz'
    pon                 = 'data/resources/1000g_pon.chr20.vcf.gz'
    survivor_consensus  = 2
    survivor_max_dist   = 1000
    publish_bams        = false
    truvari_pctseq      = 0.7
    truvari_dup_to_ins  = false
    clairs_platform     = 'ont_r10_dorado_sup_5khz_ssrs'
}

// ── Safer shell defaults for process scripts ──────────────────────────────────
// -e: exit on error; -u: error on undefined vars; -o pipefail: fail on pipeline errors.
process.shell = ['/bin/bash', '-euo', 'pipefail']

// ── Includes ──────────────────────────────────────────────────────────────────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/routing.config'

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    docker {
        includeConfig 'conf/docker.config'
    }
    wgs {
	params.reference = 'data/reference/hs38dh/GRCh38_full_analysis_set_plus_decoy_hla.fa'
        params.target_region      = null
        params.call_regions       = null
	params.germline_resource  = null
	params.pon		  = null	
	params.publish_bams       = false
    }
}

// ── Executor (machine-level limits, not per-process) ──────────────────────────
executor {
    cpus   = 8
    memory = '40 GB'
}

// Deterministic trace fields for §5.3 parsing. Overwrite per-run.
trace {
    enabled   = true
    overwrite = true
    file      = "trace/trace_${new java.util.Date().format('yyyyMMdd_HHmmss')}.txt"
    fields    = 'task_id,process,tag,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,status,exit,attempt'
}

report   { enabled = true; overwrite = true; file = "trace/report_${new java.util.Date().format('yyyyMMdd_HHmmss')}.html" }
timeline { enabled = true; overwrite = true; file = "trace/timeline_${new java.util.Date().format('yyyyMMdd_HHmmss')}.html" }

cleanup = true
