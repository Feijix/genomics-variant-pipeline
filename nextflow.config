/*
 * genomics-variant-pipeline — top-level Nextflow configuration
 *
 * This file is the single source of truth for pipeline configuration.
 * Process-level resource directives live in conf/base.config.
 * Per-process publishDir and extra args live in conf/modules.config.
 * Container/executor profiles live in conf/<profile>.config.
 */

// ── Pipeline metadata ─────────────────────────────────────────────────────────
manifest {
    name            = 'genomics-variant-pipeline'
    author          = 'Afonso'
    homePage        = 'https://github.com/feijix/genomics-variant-pipeline'
    description     = 'Reproducible, technology-aware variant calling pipeline with Beacon v2 output'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '0.6.0-dev'
}

// ── Pipeline parameter defaults ───────────────────────────────────────────────
// Override at runtime with --paramName value or in a -params-file.
params {
    samplesheet = 'data/samplesheet.csv'
    reference   = 'data/reference/GRCh38.fa'
    outdir      = 'data/outputs'
    vep_cache   = "${System.getenv('HOME')}/vep_data"
}

// ── Safer shell defaults for process scripts ──────────────────────────────────
// -e: exit on error; -u: error on undefined vars; -o pipefail: fail on pipeline errors.
process.shell = ['/bin/bash', '-euo', 'pipefail']

// ── Includes ──────────────────────────────────────────────────────────────────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    docker {
        includeConfig 'conf/docker.config'
    }
}

// ── Executor (machine-level limits, not per-process) ──────────────────────────
executor {
    cpus   = 8
    memory = '40 GB'
}

cleanup = true