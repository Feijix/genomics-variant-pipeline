# Pinned SURVIVOR image for the genomics-variant-pipeline.
#
# Reproducibility: exact version fixed. SURVIVOR 1.0.7
# (github.com/fritzsedlazeck/SURVIVOR).
#
# SURVIVOR is C++; no PyPI/conda pin we control, so we build the tagged release
# from source. Used for SV-SV ensemble merging (Sniffles2 + cuteSV) — fuzzy,
# breakpoint-tolerant merging that bcftools (exact-match) cannot do for SVs.
#
# Build once on the server:
#   docker build -t survivor:1.0.7 -f Dockerfile.survivor .
#
# Merge command (in the module):
#   union (>=1 caller):     SURVIVOR merge list 1000 1 1 1 0 50 union.vcf
#   intersect (>=2 callers): SURVIVOR merge list 1000 2 1 1 0 50 intersect.vcf

FROM ubuntu:22.04

# build-essential covers gcc/make for both builds.
# bzip2/lzma/curl dev headers are bcftools requirements: without libcurl4-openssl-dev
# bcftools builds fine but cannot read remote (HTTPS) files.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        zlib1g-dev \
        bzip2 \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        wget \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Build the pinned 1.0.7 release from source. (Tag is '1.0.7', no 'v' prefix.)
RUN wget -q https://github.com/fritzsedlazeck/SURVIVOR/archive/refs/tags/1.0.7.tar.gz \
        -O survivor.tar.gz \
    && tar xzf survivor.tar.gz \
    && cd SURVIVOR-1.0.7/Debug \
    && make \
    && cp SURVIVOR /usr/local/bin/SURVIVOR \
    && cd / \
    && rm -rf survivor.tar.gz SURVIVOR-1.0.7

# bcftools 1.19 from source. Ubuntu 22.04's apt ships 1.13; the pipeline
# standardises on 1.19+ (matching staphb/bcftools) so VCF handling is identical
# in every process that touches a VCF. Used here for sort + index of SURVIVOR's
# plain-VCF output.
RUN wget -q https://github.com/samtools/bcftools/releases/download/1.19/bcftools-1.19.tar.bz2 \
    && tar -xjf bcftools-1.19.tar.bz2 \
    && cd bcftools-1.19 \
    && ./configure --prefix=/usr/local \
    && make -j4 \
    && make install \
    && cd / \
    && rm -rf bcftools-1.19 bcftools-1.19.tar.bz2

# Sanity checks — SURVIVOR exits non-zero on a bare call, so grep for the
# version string; bcftools --version fails the build loudly if it is broken.
RUN SURVIVOR 2>&1 | grep -i 'Version' || true
RUN bcftools --version | head -1

ENTRYPOINT []
